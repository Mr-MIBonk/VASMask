// Version resource of the 64-bit shim. ContiTool reads the file version of the
// D-PDU API DLL registered in rdf64.xml and connects without a confirmation
// only for VW driver versions it has verified (27.2, 31.0, 31.1).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 31,1,0,0
PRODUCTVERSION 31,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "VAS6154 mask shim for the VW D-PDU API"
			VALUE "FileVersion", "31.1.0.0"
			VALUE "ProductVersion", "31.1.0.0"
			VALUE "OriginalFilename", "PDUAPI_VAS6154_Shim.dll"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
